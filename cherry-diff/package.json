{
  "name": "cherry-diff",
  "displayName": "Cherry Diff",
  "description": "Per-hunk approve/reject UI for file edits.",
  "version": "0.5.2",
  "publisher": "cherry-diff",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveImmanuel/cherry-diff"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Cherry Diff",
      "properties": {
        "cherryDiff.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save files after accepting or rejecting hunks."
        },
        "cherryDiff.baselineCaptureConcurrency": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 64,
          "description": "Maximum number of files captured concurrently while preparing or extending baselines."
        },
        "cherryDiff.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*"
          ],
          "description": "Glob patterns for files/directories to track (e.g. 'src/**', 'lib/**')."
        },
        "cherryDiff.excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.venv/**",
            "**/__pycache__/**",
            "**/.git/**",
            "**/.hg/**",
            "**/.svn/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/coverage/**",
            "**/.cache/**",
            "**/.tox/**",
            "**/.mypy_cache/**",
            "**/.pytest_cache/**",
            "**/vendor/**",
            "**/target/**",
            "**/*.min.js",
            "**/*.min.css",
            "**/package-lock.json",
            "**/yarn.lock",
            "**/pnpm-lock.yaml",
            "**/Cargo.lock",
            "**/poetry.lock",
            "**/Pipfile.lock",
            "**/go.sum"
          ],
          "description": "Glob patterns for files/directories to exclude from tracking."
        },
        "cherryDiff.pathOverrides": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Per-file and per-directory include/exclude selections managed by the Tracked Files tree. Nearest selections override glob patterns."
        }
      }
    },
    "commands": [
      {
        "command": "cherryDiff.startReview",
        "title": "Cherry Diff: Start Review",
        "icon": "$(refresh)"
      },
      {
        "command": "cherryDiff.enableTracking",
        "title": "Enable Tracking",
        "icon": "$(play)"
      },
      {
        "command": "cherryDiff.disableTracking",
        "title": "Disable Tracking",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cherryDiff.acceptHunk",
        "title": "Accept Hunk",
        "icon": "$(check)"
      },
      {
        "command": "cherryDiff.rejectHunk",
        "title": "Reject Hunk",
        "icon": "$(x)"
      },
      {
        "command": "cherryDiff.acceptAllFile",
        "title": "Accept All Hunks in File",
        "icon": "$(check-all)"
      },
      {
        "command": "cherryDiff.rejectAllFile",
        "title": "Reject All Hunks in File",
        "icon": "$(close-all)"
      },
      {
        "command": "cherryDiff.acceptAll",
        "title": "Cherry Diff: Accept All Changes"
      },
      {
        "command": "cherryDiff.rejectAll",
        "title": "Cherry Diff: Reject All Changes"
      },
      {
        "command": "cherryDiff.openDiff",
        "title": "Open Diff View",
        "icon": "$(diff)"
      },
      {
        "command": "cherryDiff.editFilters",
        "title": "Show Tracked Files",
        "icon": "$(filter)"
      },
      {
        "command": "cherryDiff.nextHunk",
        "title": "Cherry Diff: Next Hunk"
      },
      {
        "command": "cherryDiff.prevHunk",
        "title": "Cherry Diff: Previous Hunk"
      },
      {
        "command": "cherryDiff.clearPathOverrides",
        "title": "Cherry Diff: Reset File Selections",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cherryDiff.startReview",
          "when": "view == cherryDiffReview",
          "group": "navigation"
        },
        {
          "command": "cherryDiff.clearPathOverrides",
          "when": "view == cherryDiffFilters",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "cherryDiff.acceptHunk",
          "when": "view == cherryDiffReview && viewItem == hunk",
          "group": "inline@1"
        },
        {
          "command": "cherryDiff.rejectHunk",
          "when": "view == cherryDiffReview && viewItem == hunk",
          "group": "inline@2"
        },
        {
          "command": "cherryDiff.acceptAllFile",
          "when": "view == cherryDiffReview && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "cherryDiff.rejectAllFile",
          "when": "view == cherryDiffReview && viewItem == file",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cherryDiff.nextHunk",
        "key": "alt+]",
        "when": "cherryDiff.reviewActive"
      },
      {
        "command": "cherryDiff.prevHunk",
        "key": "alt+[",
        "when": "cherryDiff.reviewActive"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cherryDiff",
          "title": "Cherry Diff",
          "icon": "$(diff)"
        }
      ]
    },
    "views": {
      "cherryDiff": [
        {
          "id": "cherryDiffControls",
          "name": "Controls",
          "type": "webview",
          "initialSize": 3
        },
        {
          "id": "cherryDiffReview",
          "name": "Review",
          "initialSize": 7
        },
        {
          "id": "cherryDiffFilters",
          "name": "Tracked Files",
          "initialSize": 6
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cherryDiffReview",
        "contents": "No changes to review.",
        "when": "cherryDiff.tracking"
      },
      {
        "view": "cherryDiffReview",
        "contents": "Tracking is disabled.",
        "when": "!cherryDiff.tracking"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node --test"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "diff": "^7.0.0"
  }
}
