{
  "name": "cherry-diff",
  "displayName": "Cherry Diff",
  "description": "Per-hunk approve/reject UI for file edits.",
  "version": "0.7.0",
  "publisher": "cherry-diff",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveImmanuel/vibe-projects",
    "directory": "cherry-diff"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Cherry Diff",
      "properties": {
        "cherryDiff.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save files after accepting or rejecting hunks."
        },
        "cherryDiff.baselineCaptureConcurrency": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 64,
          "description": "Maximum number of files captured concurrently while preparing or extending baselines."
        },
        "cherryDiff.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*"
          ],
          "description": "Glob patterns for files/directories to track (e.g. 'src/**', 'lib/**')."
        },
        "cherryDiff.excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.venv/**",
            "**/__pycache__/**",
            "**/.git/**",
            "**/.hg/**",
            "**/.svn/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/coverage/**",
            "**/.cache/**",
            "**/.tox/**",
            "**/.mypy_cache/**",
            "**/.pytest_cache/**",
            "**/vendor/**",
            "**/target/**",
            "**/*.min.js",
            "**/*.min.css",
            "**/package-lock.json",
            "**/yarn.lock",
            "**/pnpm-lock.yaml",
            "**/Cargo.lock",
            "**/poetry.lock",
            "**/Pipfile.lock",
            "**/go.sum"
          ],
          "description": "Glob patterns for files/directories to exclude from tracking."
        },
        "cherryDiff.checkedDirectoriesOverrideExcludes": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, checking a directory in Tracked Files re-includes everything beneath it, even paths matching excludePaths. When disabled, excludePaths still applies beneath checked directories; explicitly checking a file always includes it."
        }
      }
    },
    "commands": [
      {
        "command": "cherryDiff.startReview",
        "title": "Cherry Diff: Refresh Review",
        "icon": "$(refresh)",
        "enablement": "cherryDiff.tracking"
      },
      {
        "command": "cherryDiff.enableTracking",
        "title": "Cherry Diff: Start Tracking",
        "icon": "$(play)",
        "enablement": "!cherryDiff.tracking && !cherryDiff.initializing"
      },
      {
        "command": "cherryDiff.disableTracking",
        "title": "Cherry Diff: Stop Tracking",
        "icon": "$(debug-stop)",
        "enablement": "cherryDiff.tracking || cherryDiff.initializing"
      },
      {
        "command": "cherryDiff.acceptHunk",
        "title": "Accept Hunk",
        "icon": "$(check)"
      },
      {
        "command": "cherryDiff.rejectHunk",
        "title": "Reject Hunk",
        "icon": "$(x)"
      },
      {
        "command": "cherryDiff.acceptAllFile",
        "title": "Accept All Hunks in File",
        "icon": "$(check-all)"
      },
      {
        "command": "cherryDiff.rejectAllFile",
        "title": "Reject All Hunks in File",
        "icon": "$(close-all)"
      },
      {
        "command": "cherryDiff.acceptAll",
        "title": "Cherry Diff: Accept All Changes"
      },
      {
        "command": "cherryDiff.rejectAll",
        "title": "Cherry Diff: Reject All Changes"
      },
      {
        "command": "cherryDiff.openDiff",
        "title": "Open Diff View",
        "icon": "$(diff)"
      },
      {
        "command": "cherryDiff.editFilters",
        "title": "Show Tracked Files",
        "icon": "$(filter)"
      },
      {
        "command": "cherryDiff.nextHunk",
        "title": "Cherry Diff: Next Hunk"
      },
      {
        "command": "cherryDiff.prevHunk",
        "title": "Cherry Diff: Previous Hunk"
      },
      {
        "command": "cherryDiff.clearPathOverrides",
        "title": "Cherry Diff: Reset File Selections",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cherryDiff.startReview",
          "when": "view == cherryDiffReview && cherryDiff.tracking",
          "group": "navigation"
        },
        {
          "command": "cherryDiff.clearPathOverrides",
          "when": "view == cherryDiffFilters && !cherryDiff.initializing",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "cherryDiff.acceptHunk",
          "when": "false"
        },
        {
          "command": "cherryDiff.rejectHunk",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "cherryDiff.acceptHunk",
          "when": "view == cherryDiffReview && viewItem == hunk",
          "group": "inline@1"
        },
        {
          "command": "cherryDiff.rejectHunk",
          "when": "view == cherryDiffReview && viewItem == hunk",
          "group": "inline@2"
        },
        {
          "command": "cherryDiff.acceptAllFile",
          "when": "view == cherryDiffReview && viewItem == file",
          "group": "inline@1"
        },
        {
          "command": "cherryDiff.rejectAllFile",
          "when": "view == cherryDiffReview && viewItem == file",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cherryDiff.nextHunk",
        "key": "alt+]",
        "when": "cherryDiff.reviewActive"
      },
      {
        "command": "cherryDiff.prevHunk",
        "key": "alt+[",
        "when": "cherryDiff.reviewActive"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cherryDiff",
          "title": "Cherry Diff",
          "icon": "$(diff)"
        }
      ]
    },
    "views": {
      "cherryDiff": [
        {
          "id": "cherryDiffControls",
          "name": "Controls",
          "type": "webview",
          "initialSize": 3
        },
        {
          "id": "cherryDiffReview",
          "name": "Review",
          "initialSize": 7
        },
        {
          "id": "cherryDiffFilters",
          "name": "Tracked Files",
          "initialSize": 6
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cherryDiffReview",
        "contents": "No changes to review.",
        "when": "cherryDiff.tracking"
      },
      {
        "view": "cherryDiffReview",
        "contents": "Preparing baselines.",
        "when": "cherryDiff.initializing"
      },
      {
        "view": "cherryDiffReview",
        "contents": "Tracking is disabled.",
        "when": "!cherryDiff.tracking && !cherryDiff.initializing"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node --test",
    "check": "npm test && npm run lint"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "8.57.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "diff": "8.0.3",
    "minimatch": "9.0.7"
  }
}
